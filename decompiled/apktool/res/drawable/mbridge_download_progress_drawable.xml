<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="5.0dp" />
            <gradient android:startColor="#ffe7e5e5" android:endColor="#ffe7e5e5" android:angle="0.0" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="5.0dp" />
                <gradient android:startColor="#ff80c32e" android:endColor="#ff80c32e" android:angle="0.0" />
            </shape>
        </clip>
    </item>
</layer-list>
