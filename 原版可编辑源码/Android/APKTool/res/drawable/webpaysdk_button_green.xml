<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/reslib_px_3" />
            <solid android:color="@color/reslib_green_accent" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="@dimen/reslib_px_3" />
            <stroke android:width="1.0dp" android:color="@color/reslib_grey_unable_frame" />
            <solid android:color="@color/reslib_grey_unable" />
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape>
            <corners android:radius="@dimen/reslib_px_3" />
            <solid android:color="@color/reslib_green_light" />
        </shape>
    </item>
</selector>
