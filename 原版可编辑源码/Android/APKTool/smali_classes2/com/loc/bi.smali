.class public final Lcom/loc/bi;
.super Lcom/loc/bh;
.source "GZipEncryptProcessor.java"


# direct methods
.method public constructor <init>()V
    .locals 0

    invoke-direct {p0}, Lcom/loc/bh;-><init>()V

    return-void
.end method

.method public constructor <init>(Lcom/loc/bh;)V
    .locals 0

    invoke-direct {p0, p1}, Lcom/loc/bh;-><init>(Lcom/loc/bh;)V

    return-void
.end method


# virtual methods
.method protected final a([B)[B
    .locals 0

    invoke-static {p1}, Lcom/loc/x;->d([B)[B

    move-result-object p1

    return-object p1
.end method
